{
  "name": "squishify",
  "version": "1.0.0",
  "description": "Interactive CLI that batch-processes a folder of images for a design -> product workflow",
  "license": "MIT",
  "author": "Piotr Butkiewicz",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "squishify": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SpacemanPete/squishify.git"
  },
  "homepage": "https://github.com/SpacemanPete/squishify#readme",
  "bugs": {
    "url": "https://github.com/SpacemanPete/squishify/issues"
  },
  "keywords": [
    "image",
    "cli",
    "batch",
    "resize",
    "convert",
    "compress",
    "optimize",
    "webp",
    "avif",
    "sharp",
    "interactive"
  ],
  "scripts": {
    "dev": "node src/index.ts",
    "start": "node src/index.ts",
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "test": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
